{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Vysted Terminal",
  "version": "0.9.0",
  "identifier": "com.vysted.terminal",
  "build": {
    "frontendDist": "../out",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "node scripts/ensure-all-sidecars.mjs && pnpm dev",
    "beforeBuildCommand": "node scripts/ensure-all-sidecars.mjs && pnpm build"
  },
  "app": {
    "windows": [
      {
        "title": "Vysted Terminal",
        "width": 1280,
        "height": 832,
        "minWidth": 960,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "theme": "Dark",
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage", "nsis", "app", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/vysted-sidecar",
      "binaries/vysted-openbb-mcp-sidecar",
      "binaries/vysted-sec-edgar-mcp-sidecar",
      "binaries/llama-server"
    ],
    "createUpdaterArtifacts": false,
    "macOS": {
      "dmg": {
        "background": "dmg/background.png",
        "windowSize": { "width": 660, "height": 400 },
        "appPosition": { "x": 180, "y": 150 },
        "applicationFolderPosition": { "x": 480, "y": 150 }
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/techlogist1/vysted-terminal/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDg5RkYzOEY3NTI0NTUzRUQKUldUdFUwVlM5emovaVUrYkR0enpFRGg1Y3AyVER1OGE3KzhQNjRrUmVWc1BpNEJuNDdkZDVBQ3gK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
