+/** A scope the model wrote as a ticker (`NVDA`, `RELIANCE.NS`, `BTC/USDT`), not
+ *  a company name (`Cochin Shipyard`, `Infosys`). */
+const TICKER_SHAPED = /^[A-Z0-9][A-Z0-9.\-&^/]{0,19}$/;
+
+/**
+ * File a note given a company NAME under its resolved ticker (`GET /resolve`,
+ * the policy add_to_watchlist uses), so `noteFor("COCHINSHIP")` finds it
+ * (R15-FINAL-030). Nothing resolves: the literal name stays the bucket and
+ * the label says so.
+ */
+async function writeResolvedNote(
+  intent: Extract<HostIntent, { name: "write_note" }>,
+): Promise<ApplyResult> {
+  let resolved: string | null = null;
+  try {
+    const reply = await sidecarGet<ResolveReply>("/resolve", { q: intent.rawScope });
+    resolved = reply.resolved?.symbol.toUpperCase() ?? null;
+  } catch {
+    // The sidecar did not answer: keep the literal, said so below.
+  }
+  const result = applyIntent({ ...intent, scope: resolved ?? intent.scope });
+  if (result.label === null) {
+    return result;
+  }
+  const note = resolved
+    ? ` (resolved from "${intent.rawScope}")`
+    : ` ("${intent.rawScope}" did not resolve to a listing; filed under the name)`;
+  return { ...result, label: result.label + note };
+}
