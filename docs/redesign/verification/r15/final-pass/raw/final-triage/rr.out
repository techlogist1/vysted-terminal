[{"id":"d3c8067a9bce5466","title":"'A hero of our times': Mankind Pharma to give ₹1 crore to FlyDubai Capt Smit Machchhar","summary":"Mankind Pharma has announced a ₹1 crore contribution to Capt Smit Machchhar and his family, praising his courage and leadership during a crisis. Vice Chairman Rajeev Juneja said the gesture was the company's way of backing its gratitude with meaningful action.","url":"https://www.livemint.com/news/india/a-hero-of-our-times-mankind-pharma-to-give-rs-1-crore-to-flydubai-capt-smit-machchhar-11791030726742.html","source":"mint - news","published_at":"2026-10-03T12:46:28Z","symbols":[],"sentiment":0.8979,"sentiment_label":"positive","provider":"rss","via_symbol_feed":false},{"id":"38bd9ba69f1ff60a","title":"Delhi Changes Rules To Ease Private School Establishment On Commercial Land","summary":"Delhi has amended school education rules, removing public-interest and “real need” requirements for private schools on commercial land. Proposals will still face administrative scrutiny, with the LG retaining final approval authority.","url":"https://www.ndtvprofit.com/india/delhi-changes-rules-to-ease-private-school-establishment-on-commercial-land-12133687#publisher=newsstand","source":"Pulse by Zerodha","published_at":"2026-10-03T12:15:12Z","symbols":[],"sentiment":0.7096,"sentiment_label":"positive","provider":"rss","via_symbol_feed":false},{"id":"65fb9695240bb7ee","title":"Siberia On Alert: Nearly 200 Isolated, Events Cancelled After Suspected Pneumonic Plague Death","summary":"Media accounts have described it as pneumonic plague, the form that attacks the lungs and can pass between people through respiratory droplets. It is the most dangerous variant of the disease.","url":"https://www.ndtvprofit.com/world/siberia-on-alert-nearly-200-isolated-events-cancelled-after-suspected-pneumonic-plague-death-12133551#publisher=newsstand","source":"Pulse by Zerodha","published_at":"2026-10-03T12:12:04Z","symbols":[],"sentiment":-0.9216,"sentiment_label":"negative","provider":"rss","via_symbol_feed":false},{"id":"25464bc7d0d311a6","title":"India Thrash Malaysia 5-1 To Win Asian Games 2026 Men's Hockey Gold, Seal LA 2028 Berth","summary":"India overcame Malaysia's early fightback to produce a commanding 5-1 victory in the gold-medal match. With this win, India have defended their gold from the previous Asian Games.","url":"https://www.ndtvprofit.com/sports/india-thrash-malaysia-5-1-to-win-asian-games-2026-mens-hockey-gold-seal-la-2028-berth-12134053#publisher=newsstand","source":"Pulse by Zerodha","published_at":"2026-10-03T12:10:31Z","symbols":[],"sentiment":0.8519,"sentiment_label":"positive","provider":"rss","via_symbol_feed":false},{"id":"8c894e47a725a32c","title":"Bank of India Q2 Update: Global Business Nears Rs 19 Lakh Crore, Advances Up 20%","summary":"The public sector lender's global business rose 21% year-on-year to Rs 18.9 lakh crore, while domestic business grew 23% from a year earlier to Rs 16 lakh crore.","url":"https://www.ndtvprofit.com/markets/bank-of-india-q2-update-global-business-nears-rs-19-lakh-crore-advances-up-20-12134111#publisher=newsstand","source":"Pulse by Zerodha","published_at":"2026-10-03T12:08:24Z","symbols":[],"sentiment":0.0,"sentiment_label":"neutral","provider":"rss","via_symbol_feed":false},{"id":"b4d68bb1b7557c23","title":"India's Gulf Oil Imports Jump In September As Suppliers Find Way Around Hormuz Risk","summary":"Iraq, Saudi Arabia and Kuwait sharply increased oil shipments to India in September as ship-to-ship transfers helped navigate Strait of Hormuz risks.","url":"https://www.ndtvprofit.com/economy/indias-gulf-oil-imports-jump-in-september-as-suppliers-find-way-around-hormuz-risk-12133642#publisher=newsstand","source":"Pulse by Zerodha","published_at":"2026-10-03T12:05:02Z","symbols":[],"sentiment":-0.2732,"sentiment_label":"negative","provider":"rss","via_symbol_feed":false},{"id":"f1bc61c8da428f41","title":"Tata Motors PV Q2 Business Update: JLR Wholesale Volumes Up 24.5%, Retail Sales Decline","summary":"The company said the growth in wholesale volumes reflects a recovery from the impact of a cyber incident a year ago.","url":"https://www.ndtvprofit.com/markets/tata-motors-pv-q2-business-update-jlr-wholesale-volumes-up-24-5-retail-sales-decline-7-5-12134000#publisher=newsstand","source":"Pulse by Zerodha","published_at":"2026-10-03T11:41:56Z","symbols":[],"sentiment":0.3818,"sentiment_label":"positive","provider":"rss","via_symbol_feed":false},{"id":"03dd6a4d472b13a3","title":"Nestle Low Fat Dairy Whitener sale banned: Why FSSAI called it ‘unsafe, substandard’","summary":"The Food Safety and Standards Authority of India (FSSAI) has ordered immediate sale ban on Nestle Low Fat Dairy Whitener. A sample of the product collected from a New Delhi hotel was found to be ‘unsafe, substandard’ in a laboratory analysis.","url":"https://www.livemint.com/news/india/nestle-low-fat-dairy-whitener-sale-banned-why-fssai-called-it-unsafe-substandard-11791025488232.html","source":"mint - news","published_at":"2026-10-03T11:40:52Z","symbols":[],"sentiment":-0.7717,"sentiment_label":"negative","provider":"rss","via_symbol_feed":false},{"id":"5fd8fbc5c6bf00ec","title":"RBI governor warns against complacency amid external headwinds","summary":"Governor Malhotra flagged global debt, AI valuations, leverage and cyber risk as potential threats to financial stability","url":"https://www.livemint.com/news/india/rbi-governor-warns-against-complacency-amid-external-headwinds-11791020910405.html","source":"mint - news","published_at":"2026-10-03T11:39:24Z","symbols":[],"sentiment":-0.7783,"sentiment_label":"negative","provider":"rss","via_symbol_feed":false},{"id":"b9015e85004e1bb8","title":"Neelkanth Mishra Says Global Market Stress Already Visible, Fuel Prices And Bond Yields Rising","summary":"Global market stress is already feeding into fuel demand, bond yields and borrowing costs, while India is seeing revived credit growth and st