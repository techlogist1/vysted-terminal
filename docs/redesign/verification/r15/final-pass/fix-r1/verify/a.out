ed":false},{"id":"65fb9695240bb7ee","title":"Siberia On Alert: Nearly 200 Isolated, Events Cancelled After Suspected Pneumonic Plague Death","summary":"Media accounts have described it as pneumonic plague, the form that attacks the lungs and can pass between people through respiratory droplets. It is the most dangerous variant of the disease.","url":"https://www.ndtvprofit.com/world/siberia-on-alert-nearly-200-isolated-events-cancelled-after-suspected-pneumonic-plague-death-12133551#publisher=newsstand","source":"Pulse by Zerodha","published_at":"2026-10-03T12:12:04Z","symbols":[],"sentiment":-0.9216,"sentiment_label":"negative","provider":"rss","via_symbol_feed":false},{"id":"25464bc7d0d311a6","title":"India Thrash Malaysia 5-1 To Win Asian Games 2026 Men's Hockey Gold, Seal LA 2028 Berth","summary":"India overcame Malaysia's early fightback to produce a commanding 5-1 victory in the gold-medal match. With this win, India have defended their gold from the previous Asian Games.","url":"https://www.ndtvprofit.com/sports/india-thrash-malaysia-5-1-to-win-asian-games-2026-mens-hockey-gold-seal-la-2028-berth-12134053#publisher=newsstand","source":"Pulse by Zerodha","published_at":"2026-10-03T12:10:31Z","symbols":[],"sentiment":0.8519,"sentiment_label":"positive","provider":"rss","via_symbol_feed":false},{"id":"8c894e47a725a32c","title":"Bank of India Q2 Update: Global Business Nears Rs 19 Lakh Crore, Advances Up 20%","summary":"The public sector lender's global business rose 21% year-on-year to Rs 18.9 lakh crore, while domestic business grew 23% from a year earlier to Rs 16 lakh crore.","url":"https://www.ndtvprofit.com/markets/bank-of-india-q2-update-global-business-nears-rs-19-lakh-crore-advances-up-20-12134111#publisher=newsstand","source":"Pulse by Zerodha","published_at":"2026-10-03T12:08:24Z","symbols":[],"sentiment":0.0,"sentiment_label":"neutral","provider":"rss","via_symbol_feed":false},{"id":"b4d68bb1b7557c23","title":"India's Gulf Oil Imports Jump In September As Suppliers Find Way Around Hormuz Risk","summary":"Iraq, Saudi Arabia and Kuwait sharply increased oil shipments to India in September as ship-to-ship transfers helped navigate Strait of Hormuz risks.","url":"https://www.ndtvprofit.com/economy/indias-gulf-oil-imports-jump-in-september-as-suppliers-find-way-around-hormuz-risk-12133642#publisher=newsstand","source":"Pulse by Zerodha","published_at":"2026-10-03T12:05:02Z","symbols":[],"sentiment":-0.2732,"sentiment_label":"negative","provider":"rss","via_symbol_feed":false},{"id":"f1bc61c8da428f41","title":"Tata Motors PV Q2 Business Update: JLR Wholesale Volumes Up 24.5%, Retail Sales Decline","summary":"The company said the growth in wholesale volumes reflects a recovery from the impact of a cyber incident a year ago.","url":"https://www.ndtvprofit.com/markets/tata-motors-pv-q2-business-update-jlr-wholesale-volumes-up-24-5-retail-sales-decline-7-5-12134000#publisher=newsstand","source":"Pulse by Zerodha","published_at":"2026-10-03T11:41:56Z","symbols":[],"sentiment":0.3818,"sentiment_label":"positive","provider":"rss","via_symbol_feed":false},{"id":"03dd6a4d472b13a3","title":"Nestle Low Fat Dairy Whitener sale banned: Why FSSAI called it ‘unsafe, substandard’","summary":"The Food Safety and Standards Authority of India (FSSAI) has ordered immediate sale ban on Nestle Low Fat Dairy Whitener. A sample of the product collected from a New Delhi hotel was found to be ‘unsafe, substandard’ in a laboratory analysis.","url":"https://www.livemint.com/news/india/nestle-low-fat-dairy-whitener-sale-banned-why-fssai-called-it-unsafe-substandard-11791025488232.html","source":"mint - news","published_at":"2026-10-03T11:40:52Z","symbols":[],"sentiment":-0.7717,"sentiment_label":"negative","provider":"rss","via_symbol_feed":false},{"id":"5fd8fbc5c6bf00ec","title":"RBI governor warns against complacency amid external headwinds","summary":"Governor Malhotra flagged global debt, AI valuations, leverage and cyber risk as potential threats to financial stability","url":"https://www.livemint.com/news/india/rbi-governor-warns-against-complacency-amid-external-headwinds-11791020910405.html","source":"mint - news","published_at":"2026-10-03T11:39:24Z","symbols":[],"sentiment":-0.7783,"sentiment_label":"negative","provider":"rss","via_symbol_feed":false},{"id":"b9015e85004e1bb8","title":"Neelkanth Mishra Says Global Market Stress Already Visible, Fuel Prices And Bond Yields Rising","summary":"Global market stress is already feeding into fuel demand, bond yields and borrowing costs, while India is seeing revived credit growth and sticking to fiscal deficit targets, Neelkanth Mishra said.","url":"https://www.ndtvprofit.com/markets/neelkanth-mishra-says-global-market-stress-already-visible-fuel-prices-and-bond-yields-rising-12133792#publisher=newsstand","source":"Pulse by Zerodha","published_at":"2026-10-03T11:38:13Z","symbols":[],"sentiment":-0.5574,"sentiment_label":"negative","provider":"rss","via_symbol_feed":false},{"id":"550dc862b214e8a8","title":"India Champions vs Australia Champions: When And Where To Watch WCL 2026 Match","summary":"Yuvraj Singh leads India Champions against David Warner's Australia Champions in the WCL 2026, with the match starting at 5 PM and live on Star Sports and FanCode.","url":"https://www.ndtvprofit.com/sports/india-champions-vs-australia-champions-when-and-where-to-watch-wcl-2026-match-12132638#publisher=newsstand","source":"Pulse by Zerodha","published_at":"2026-10-03T11:18:25Z","symbols":[],"sentiment":0.9274,"sentiment_label":"positive","provider":"rss","via_symbol_feed":false},{"id":"b44aa0af38f08757","title":"FM Sitharaman Seeks Greater Certainty In Global Trade, Flags Risks Of Market Fragmentation","summary":"According to Sitharaman, a more resilient global economy will require countries to diversify partnerships, keep markets open, honour commitments, and work together to keep the movement of goods, services, energy and capital as stable and predictable as possible.","url":"https://www.ndtvprofit.com/economy/fm-sitharaman-seeks-greater-certainty-in-global-trade-flags-risks-of-market-fragmentation-12133896#publisher=newsstand","source":"Pulse by Zerodha","published_at":"2026-10-03T11:11:11Z","symbols":[],"sentiment":0.872,"sentiment_label":"positive","provider":"rss","via_symbol_feed":false},{"id":"f18f290c974471c3","title":"7 investing lessons from Jim Leitner for building the right market mindset","summary":"Leitner believes investors should remain open to new ideas and recognise that markets can challenge even experienced participants.","url":"https://economictimes.indiatimes.com/markets/us-stocks/wall-street-guide/7-investing-lessons-from-jim-leitner-for-building-the-right-market-mindset/articleshow/134657619.cms","source":"Markets-Economic Times","published_at":"2026-10-03T11:07:18Z","symbols":[],"sentiment":0.0772,"sentiment_label":"positive","provider":"rss","via_symbol_feed":false},{"id":"74750f651c27dc76","title":"Earth And Mars Were Born Together. New Study Reveals Why They Became So Different","summary":"Chemical clues in Earth and Mars suggest their different formation histories may explain why the neighbouring planets evolved so differently.","url":"https://www.ndtvprofit.com/science/earth-and-mars-formed-from-same-cosmic-cloud-but-took-different-paths-study-finds-12132898#publisher=newsstand","source":"Pulse by Zerodha","published_at":"2026-10-03T11:03:28Z","symbols":[],"sentiment":0.0,"sentiment_label":"neutral","provider":"rss","via_symbol_feed":false},{"id":"3bd9f05b857dee67","title":"Powerful Explosions Rock Yemen's Capital Sanaa: Report","summary":"Explosions Shake Yemen's Capital Amid Renewed Clashes","url":"https://www.ndtvprofit.com/world/powerful-explosions-rock-yemens-capital-sanaa-report-12133848#publisher=newsstand","source":"Pulse by Zerodha","published_at":"2026-10-03T11:01:24Z","symbols":[],"sentiment":0.2732,"sentiment_label":"positive","provider":"rss","via_symbol_feed":false},{"id":"ea19970649da61f9","title":"CBI chargesheets RCom, ex-LIC investment chief in ₹3,750-cr cheating case","summary":"The agency said further investigation is continuing to ascertain the role of other accused persons and to investigate other allegations","url":"https://www.business-standard.com/companies/news/cbi-chargesheets-rcom-ex-lic-investment-chief-in-3-750-cr-cheating-case-126100300549_1.html","source":"Pulse by Zerodha","published_at":"2026-10-03T10:54:50Z","symbols":[],"sentiment":-0.7003,"sentiment_label":"negative","provider":"rss","via_symbol_feed":false},{"id":"5c57d669683d3855","title":"Asian Games 2026: Indian Wrestler Deepak Punia Wins Bronze Medal In 97kg Event","summary":"The Indian wrestler bounced back from his semifinal defeat to claim bronze in the 97kg category.","url":"https://www.ndtvprofit.com/sports/asian-games-2026-indian-wrestler-deepak-punia-wins-bronze-medal-in-97kg-event-12133786#publisher=newsstand","source":"Pulse by Zerodha","published_at":"2026-10-03T10:52:01Z","symbols":[],"sentiment":0.5859,"sentiment_label":"positive","provider":"rss","via_symbol_feed":false},{"id":"87935d1d4003d8c4","title":"140 Indians discharged from Russian army: Govt seeks Moscow update on 55, 'balanced' trade push","summary":"India and Russia discussed bilateral ties, Indian workers and the Ukraine conflict. Around 140 Indians have been discharged from the Russian army, while India is seeking information on 55 others. Putin also praised PM Modi's efforts to promote dialogue.","url":"https://www.livemint.com/news/india/140-indians-discharged-from-russian-army-govt-seeks-moscow-update-on-55-balanced-trade-push-11791022101263.html","source":"mint - news","published_at":"2026-10-03T10:47:37Z","symbols":[],"sentiment":0.5423,"sentiment_label":"positive","provider":"rss","via_symbol_feed":false},{"id":"a2a5745846f26b77","title":"$20,000 US visa bond rule: Should Indians be worried? Check the complete list of affected countries","summary":"The new US visa bond rule requires certain foreign nationals to pay a bond ranging from $10,000 to $20,000. Affected applicants must comply with payment instructions, and breaking visa conditions can lead to reviews by US immigration authorities.","url":"https://www.livemint.com/news/us-news/20000-us-visa-bond-rule-should-indians-be-worried-check-the-complete-list-of-affected-countries-11791022971829.html","source":"mint - news","published_at":"2026-10-03T10:41:53Z","symbols":[],"sentiment":-0.4019,"sentiment_label":"negative","provider":"rss","via_symbol_feed":false},{"id":"aad3cba3b8411abd","title":"Trump Visa Policies Drive Drop In Columbia Journalism Applications, Admissions Paused: Report","summary":"Trump administration visa uncertainty has sharply reduced international applications to Columbia Journalism School, prompting a one-year pause in M.A. admissions as the programme is reviewed.","url":"https://www.ndtvprofit.com/world/trump-visa-policies-drive-drop-in-columbia-journalism-applications-admissions-paused-report-12133754#publisher=newsstand","source":"Pulse by Zerodha","published_at":"2026-10-03T10:33:21Z","symbols":[],"sentiment":-0.5423,"sentiment_label":"negative","provider":"rss","via_symbol_feed":false},{"id":"8af16cce5ba4af4f","title":"D-Mart Q2 revenue rises 18% to Rs 19,206 cr; store count at 518","summary":"Avenue Supermarts has achieved an impressive 18.4% growth in standalone revenue for the second quarter of 2026, totaling Rs 19,206.18 crore, a substantial rise from Rs 16,218.79 crore compared to the same period last year. This also reflects a 4.7% increase from the preceding quarter's revenue of Rs 18,343.49 crore.","url":"https://economictimes.indiatimes.com/markets/stocks/earnings/d-mart-q2-revenue-rise-18-pc-to-rs-19206-cr-store-count-at-518/articleshow/134656472.cms","source":"Markets-Economic Times","published_at":"2026-10-03T10:06:18Z","symbols":[],"sentiment":0.8402,"sentiment_label":"positive","provider":"rss","via_symbol_feed":false},{"id":"28558a22e5fc5746","title":"SIR 2026 voter list: Name deleted? A step-by-step guide on how to get it added back — Form 6 explained","summary":"Have you been “left out” of the electoral rolls following the Special Intensive Revision (SIR)in your state? Here's a step-by-step guide to checking your name on the list and adding it back if it's missing.","url":"https://www.livemint.com/news/india/sir-2026-voter-list-name-deleted-a-step-by-step-guide-on-how-to-get-it-added-back-form-6-explained-11791019267135.html","source":"mint - news","published_at":"2026-10-03T10:02:41Z","symbols":[],"sentiment":0.2168,"sentiment_label":"positive","provider":"rss","via_symbol_feed":false},{"id":"d6ce55c6b5c6d8ee","title":"Sebi examining position limits for non-agri contracts to boost liquidity","summary":"Sebi is actively investigating position limits for non-agricultural contracts to improve market liquidity and depth. Chairman Tuhin Kanta Pandey has highlighted the importance of phased physical settlement for agricultural commodities. The organization is focused on addressing structural issues and increasing technology integration in commodity markets. Furthermore, Sebi plans to expand its educational outreach through Project Jagrook to better inform market participants.","url":"https://economictimes.indiatimes.com/markets/stocks/news/sebi-examining-position-limits-for-non-agri-contracts-to-boost-liquidity/articleshow/134656225.cms","source":"Markets-Economic Times","published_at":"2026-10-03T09:46:13Z","symbols":[],"sentiment":0.9538,"sentiment_label":"positive","provider":"rss","via_symbol_feed":false},{"id":"87685f5dfeca0a4b","title":"India’s growth must reach all to become a developed economy: VP Radhakrishnan","summary":"Vice president C.P. Radhakrishnan said GDP growth alone is not enough, stressing inclusion, formalization and women’s economic participation","url":"https://www.livemint.com/news/india/indias-growth-must-reach-all-to-become-a-developed-economy-vp-radhakrishnan-11791017523498.html","source":"mint - news","published_at":"2026-10-03T09:43:27Z","symbols":[],"sentiment":0.6608,"sentiment_label":"positive","provider":"rss","via_symbol_feed":false},{"id":"746e55539ee1e411","title":"Dalal Street Week Ahead: Oversold Nifty may rebound as volatility stays high","summary":"The technical structure has weakened materially, with the most important development being the Nifty's modest violation of its 200-week moving average, presently placed at 22,606.97. This is the first breach of this long-term average since March 2020 and makes the 22,600 area particularly important over the coming days.","url":"https://economictimes.indiatimes.com/markets/stocks/news/dalal-street-week-ahead-oversold-nifty-may-rebound-as-volatility-stays-high/articleshow/134654990.cms","source":"Markets-Economic Times","published_at":"2026-10-03T09:38:01Z","symbols":[],"sentiment":0.0992,"sentiment_label":"positive","provider":"rss","via_symbol_feed":false},{"id":"095867c5818804a8","title":"Canadian vlogger documents Bengaluru's broken footpaths; calls it ‘pathetic’. Viral video prompts repairs by authorities","summary":"A video by Bengaluru-based Canadian vlogger Caleb Friesen showing broken footpaths, rubble and large holes on Indiranagar’s 12th Main went viral. In a follow-up post, Friesen said some of the highlighted spots had been repaired.","url":"https://www.livemint.com/news/trends/canadian-vlogger-documents-bengalurus-broken-footpaths-calls-it-pathetic-viral-video-prompts-repairs-by-authorities-11791017653324.html","source":"mint - news","published_at":"2026-10-03T09:10:51Z","symbols":[],"sentiment":-0.7351,"sentiment_label":"negative","provider":"rss","via_symbol_feed":false},{"id":"98f3474c1027a71f","title":"The week in charts: Lower foodgrain target, deficient rains, cheaper stocks","summary":"In this weekly Plain Facts compilation, we present to you data-based insights, with easy-to-read charts, to help you delve deeper into the stories reported by Mint in the week gone by.","url":"https://www.livemint.com/news/india/the-week-in-charts-lower-foodgrain-target-deficient-rains-cheaper-stocks-11790838418189.html","source":"mint - news","published_at":"2026-10-03T08:45:56Z","symbols":[],"sentiment":0.128,"sentiment_label":"positive","provider":"rss","via_symbol_feed":false},{"id":"a3e8cb790a5f34dc","title":"Cube Highways Trust secures Rs.1,150 crore through AAA-rated NCDs","summary":"Cube Highways Trust has triumphantly secured Rs. 1,150 crore by issuing senior secured NCDs, boasting a competitive coupon rate of 7.50% per annum, payable quarterly for five years. Major institutional players, Axis Bank Limited and ICICI Bank Limited, were pivotal investors in this transaction. The proceeds will facilitate debt refinancing and support ongoing capital projects, as part of an ambitious financing initiative targeting Rs. 4,500 crore.","url":"https://economictimes.indiatimes.com/markets/stocks/news/cube-highways-trust-secures-rs-1150-crore-through-aaa-rated-ncds/articleshow/134655392.cms","source":"Markets-Economic Times","published_at":"2026-10-03T08:40:16Z","symbols":[],"sentiment":0.9571,"sentiment_label":"positive","provider":"rss","via_symbol_feed":false},{"id":"c14da3dcb91c713d","title":"Sebi to soon issue framework on Closing Auction Session; receives over 3,500 comments","summary":"Securities and Exchange Board of India will release a framework regarding changes to the Closing Auction Session mechanism. The regulator reviewed comments on its consultation paper about market timings and settlement methodology. Sebi intends to address specific issues related to derivatives settlement prices after consultations. Regulatory measures for corporate bond derivatives are also being developed to promote market growth.","url":"https://economictimes.indiatimes.com/markets/stocks/news/sebi-to-soon-issue-framework-on-closing-auction-session-receives-over-3500-comments/articleshow/134655426.cms","source":"Markets-Economic Times","published_at":"2026-10-03T08:38:16Z","symbols":[],"sentiment":0.7506,"sentiment_label":"positive","provider":"rss","via_symbol_feed":false},{"id":"d5462e60d22c11e0","title":"India widens crude sourcing to 43 countries to boost energy security, says top government official","summary":"PM’s principal secretary PK Mishra said resilience is about reducing excessive dependence, not cutting ties with the global economy.","url":"https://www.livemint.com/news/india/india-widens-crude-sourcing-to-43-countries-to-boost-energy-security-says-top-government-official-11791012578261.html","source":"mint - news","published_at":"2026-10-03T08:16:39Z","symbols":[],"sentiment":0.5676,"sentiment_label":"positive","provider":"rss","via_symbol_feed":false},{"id":"04b733913fad4145","title":"Flydubai pilot Smit Machchhar’s old podcast resurfaces after mid-air emergency: ‘Focus on flying, not selfies’","summary":"An old podcast featuring Indian pilot Smit Machchhar has resurfaced after his role in the flydubai cockpit emergency. Months earlier, he had urged young pilots to prioritise experience and skills over chasing airlines, aircraft or an online image.","url":"https://www.livemint.com/news/trends/flydubai-pilot-smit-machchhar-s-old-podcast-resurfaces-after-mid-air-emergency-focus-on-flying-not-selfies-11791012416469.html","source":"mint - news","published_at":"2026-10-03T08:15:56Z","symbols":[],"sentiment":-0.6369,"sentiment_label":"negative","provider":"rss","via_symbol_feed":false},{"id":"f0b98fe65f5506cf","title":"‘A lesson for us’: IAF chief AP Singh on Flydubai Captain Smit Machchhar, Russia's Su-57 jets, AMCA fifth-gen, honeytrap","summary":"At the annual press conference in New Delhi on Saturday, IAF Chief Air Chief Marshal AP Singh spoke on a host of issues involving a delay in the AMCA fifth-generation fighter programme. He also said that Russia offered India its Su-57 jets. Here are the top quoted by IAF chief AP Singh:","url":"https://www.livemint.com/news/india/a-lesson-for-us-iaf-chief-ap-singh-on-flydubai-captain-smit-machchhar-russias-su-57-jets-amca-fifth-gen-honeytrap-11791014738143.html","source":"mint - news","published_at":"2026-10-03T08:14:13Z","symbols":[],"sentiment":0.0258,"sentiment_label":"neutral","provider":"rss","via_symbol_feed":false},{"id":"0cce87f2f0a2ee60","title":"Bitcoin holds near $84,000, Ethereum moves towards $2,700 as buyers remain active","summary":"In the past 24 hours, Bitcoin and Ethereum were down 1.6% and 1.5% respectively. Among the major altcoins, BNB, Dogecoin, Solana, Hyperliquid, Dogecoin and Cardano corrected upto 3.1% whereas Tron was up 0.3%.","url":"https://economictimes.indiatimes.com/markets/cryptocurrency/bitcoin-holds-near-84000-ethereum-moves-towards-2700-as-buyers-remain-active/articleshow/134654918.cms","source":"Markets-Economic Times","published_at":"2026-10-03T08:01:37Z","symbols":[],"sentiment":0.6249,"sentiment_label":"positive","provider":"rss","via_symbol_feed":false},{"id":"2b0525e5d6f6eb04","title":"F&O Talk: 22,600 is a key Nifty support; Sudeep Shah discusses PB Fintech, Infosys, TCS strategy ahead of Q2","summary":"Analyst Sudeep Shah, Vice President and Head of Technical & Derivatives Research at SBI Securities, interacted with ETMarkets regarding the outlook for the Nifty, options data, and an index strategy for the upcoming week. The following are the edited excerpts from his chat","url":"https://economictimes.indiatimes.com/markets/expert-view/fo-talk-22600-is-a-key-nifty-support-sudeep-shah-discusses-pb-fintech-infosys-tcs-strategy-ahead-of-q2/articleshow/134654760.cms","source":"Markets-Economic Times","published_at":"2026-10-03T07:55:59Z","symbols":[],"sentiment":0.8519,"sentiment_label":"positive","provider":"rss","via_symbol_feed":false},{"id":"7e2ae1dd45849c28","title":"Who is Dino Morea? Why 90s top ramp model from Gladrags was questioned in 'scam' over BMC's ₹65 crore losses","summary":"Bollywood actor Dino Morea was called in for questioning by the Mumbai Police’s Economic Offences Wing (EOW) on Friday in connection with the alleged ₹65 crore ‘scam’ case. Here's all you need to know.","url":"https://www.livemint.com/news/india/who-is-dino-morea-why-90s-top-ramp-model-from-gladrags-was-questioned-in-scam-over-bmcs-rs-65-crore-losses-11791012550022.html","source":"mint - news","published_at":"2026-10-03T07:36:02Z","symbols":[],"sentiment":-0.8316,"sentiment_label":"negative","provider":"rss","via_symbol_feed":false},{"id":"16c7822fa90d867e","title":"FASTag rules changed for these people; will there be no need to pay tolls for 3 or 5 years now?","summary":"The Annual Pass for FASTag, costing ₹3,075, allows unlimited toll crossings for non-commercial vehicles for one year. The government has updated FASTag rules for disabled persons, providing exemptions based on disability percentage and eliminating annual renewals.","url":"https://www.livemint.com/news/india/fastag-rules-changed-for-these-people-will-there-be-no-need-to-pay-tolls-for-3-or-5-years-now-11791009042940.html","source":"mint - news","published_at":"2026-10-03T07:13:38Z","symbols":[],"sentiment":-0.3818,"sentiment_label":"negative","provider":"rss","via_symbol_feed":false},{"id":"b9d77f1b030cf84b","title":"Who is Navpreet Singh? Amit Shah says hardened narco-trafficking kingpin brought back to India from Türkiye","summary":"Home Minister Amit Shah took to X to announce the development, saying that Navpreet Singh obtained Turkish citizenship under the fake identity of Navab Virk and continued to smuggle heroin and methamphetamine to India from Afghanistan.","url":"https://www.livemint.com/news/india/who-is-navpreet-singh-amit-shah-says-hardened-narco-trafficking-kingpin-brought-back-to-india-from-trkiye-11791008767829.html","source":"mint - news","published_at":"2026-10-03T06:40:27Z","symbols":[],"sentiment":-0.836,"sentiment_label":"negative","provider":"rss","via_symbol_feed":false},{"id":"e87362d195599804","title":"9 large-cap stocks that surged over 50% in the first half of FY27","summary":"Among these, we highlight 9 large-cap stocks that have surged over 50% in the first half of FY27 so far, significantly outperforming the benchmark. (Data Source: ACE Equity)","url":"https://economictimes.indiatimes.com/markets/stocks/news/9-large-cap-stocks-that-surged-over-50-in-the-first-half-of-fy27/slideshow/134653712.cms","source":"Markets-Economic Times","published_at":"2026-10-03T06:30:20Z","symbols":[],"sentiment":0.34,"sentiment_label":"positive","provider":"rss","via_symbol_feed":false},{"id":"38cda714544db5a9","title":"Explainer: What is Mithi River Desilting case? All about ₹65 cr Mumbai 'scam' over BMC contract financial fraud","summary":"Actor Dino Morea was questioned by Mumbai Police regarding a ₹65 crore financial fraud tied to the Mithi River desilting project. Investigations revealed possible collusion between contractors and municipal officials","url":"https://www.livemint.com/news/india/explainer-what-is-mithi-river-desilting-case-all-about-rs-65-cr-mumbai-scam-over-bmc-contract-financial-fraud-11791006697500.html","source":"mint - news","published_at":"2026-10-03T06:29:13Z","symbols":[],"sentiment":-0.9136,"sentiment_label":"negative","provider":"rss","via_symbol_feed":false},{"id":"bcadd890572fa0fd","title":"Stocks to buy: Axis picks 7 largecap stocks with upside potential of up to 44%. See full list","summary":"Axis has picked 7 largecap stocks that have robust value after the sharp correction.","url":"https://economictimes.indiatimes.com/markets/stocks/news/stocks-to-buy-axis-picks-7-largecap-stocks-with-upside-potential-of-up-to-44-see-full-list/slideshow/134653534.cms","source":"Markets-Economic Times","published_at":"2026-10-03T06:15:39Z","symbols":[],"sentiment":0.5859,"sentiment_label":"positive","provider":"rss","via_symbol_feed":false},{"id":"2f8724b0f8fcb1fa","title":"Indian stocks face a cyclical correction, not a deeper earnings reset: Mahindra Manulife MF CIO","summary":"Markets are also digesting a range of near-term uncertainties, including energy price volatility, geopolitical tensions and the potential impact of AI-led disruption on future employment patterns.","url":"https://economictimes.indiatimes.com/markets/expert-view/indian-stocks-face-a-cyclical-correction-not-a-deeper-earnings-reset-mahindra-manulife-mf-cio/articleshow/134652752.cms","source":"Markets-Economic Times","published_at":"2026-10-03T05:39:05Z","symbols":[],"sentiment":-0.6705,"sentiment_label":"negative","provider":"rss","via_symbol_feed":false},{"id":"2d149a9403e27fd0","title":"Jio Platforms IPO may open on October 21, issue estimated at $3.8 billion: Report","summary":"The IPO is expected to remain open until October 23, with the anchor book likely to open on October 19. The shares are targeted to list on the stock exchanges on October 28, although the timeline remains subject to market conditions and could change depending on developments in financial markets, the report added.","url":"https://economictimes.indiatimes.com/markets/ipos/fpos/jio-platforms-ipo-may-open-on-october-21-issue-estimated-at-3-8-billion-report/articleshow/134652545.cms","source":"Markets-Economic Times","published_at":"2026-10-03T05:16:10Z","symbols":[],"sentiment":0.296,"sentiment_label":"positive","provider":"rss","via_symbol_feed":false},{"id":"3b3ad0231ec88ade","title":"Robinhood stock tokens turbocharge a new era of meme trading","summary":"Traders are actively engaging in memecoin and stock token swaps on Robinhood's platform, blurring traditional investment lines. The SEC has allowed temporary tokenized stock trades, reflecting a growing retail trend. Companies like AMC have expressed concerns over tokens trading without their involvement. As these trades evolve, stock prices may become detached from their underlying assets. This shift signifies a potential change in how risk is perceived by day traders.","url":"https://economictimes.indiatimes.com/markets/cryptocurrency/robinhood-stock-tokens-turbocharge-a-new-era-of-meme-trading/articleshow/134652233.cms","source":"Markets-Economic Times","published_at":"2026-10-03T05:04:50Z","symbols":[],"sentiment":0.7184,"sentiment_label":"positive","provider":"rss","via_symbol_feed":false},{"id":"0aff9d4c2505b745","title":"Concurrent Losers: 14 midcap stocks decline for 5 consecutive sessions","summary":"Over the last five trading sessions ended October 1, the benchmark Sensex declined 2.27%, or 1,671 points, to close at 71,909. The index recorded losses in four of the five sessions.","url":"https://economictimes.indiatimes.com/markets/stocks/news/concurrent-losers-14-midcap-stocks-decline-for-5-consecutive-sessions/slideshow/134652347.cms","source":"Markets-Economic Times","published_at":"2026-10-03T04:49:57Z","symbols":[],"sentiment":-0.7269,"sentiment_label":"negative","provider":"rss","via_symbol_feed":false},{"id":"e272daef0b5e726a","title":"Shivon Zilis confirms split with Elon Musk: Who is the Neuralink executive and business confidante of the Tesla boss?","summary":"Elon Musk-Shivon Zilis split: The Neuralink executive, who shares four children with Musk, publicly confirmed their relationship had ended. Zilis said she hoped they could remain “great friends and coparents” and shared an emotional account of the breakup on X.","url":"https://www.livemint.com/news/us-news/shivon-zilis-confirms-split-with-elon-musk-who-is-the-neuralink-executive-and-business-confidante-of-the-tesla-boss-11791000101518.html","source":"mint - news","published_at":"2026-10-03T04:31:36Z","symbols":[],"sentiment":0.872,"sentiment_label":"positive","provider":"rss","via_symbol_feed":false},{"id":"a558e4cfbf887682","title":"‘Women’s safety is a joke in DU’: Students speak out after 2 girls allege harassment, SUV chase | Exclusive","summary":"Two Delhi University students allege they were harassed and followed by men in a car late at night. They said repeated calls to 112 went unanswered and police stations sent them elsewhere, with no Zero FIR initially registered, raising wider concerns over women’s safety on campus.","url":"https://www.livemint.com/news/india/womens-safety-is-a-joke-in-du-students-speak-out-after-2-girls-allege-harassment-suv-chase-exclusive-11790954867050.html","source":"mint - news","published_at":"2026-10-03T04:30:06Z","symbols":[],"sentiment":-0.2263,"sentiment_label":"negative","provider":"rss","via_symbol_feed":false},{"id":"d0bd0a9c81a92505","title":"Bleak Winter! Why analysts are hinting at painful October even after 8 weeks of Nifty correction?","summary":"The global backdrop remains the biggest problem. US yields above 5%, a firm dollar, higher crude prices and rupee weakness make India more vulnerable.","url":"https://economictimes.indiatimes.com/markets/stocks/news/bleak-winter-why-analysts-are-hinting-at-painful-october-even-after-8-weeks-of-nifty-correction/articleshow/134651765.cms","source":"Markets-Economic Times","published_at":"2026-10-03T04:15:48Z","symbols":[],"sentiment":-0.8976,"sentiment_label":"negative","provider":"rss","via_symbol_feed":false},{"id":"32cb92d76ea95eb1","title":"IPO Calendar: Quiet week ahead after Rs 39,000 crore September rush, but Street to see 29 listings","summary":"The momentum had picked up sharply from August, after a muted first four months of FY27, as stronger listing gains and steady liquidity pulled investors back into new issues.","url":"https://economictimes.indiatimes.com/markets/ipos/fpos/ipo-calendar-quiet-week-ahead-after-rs-39000-crore-september-rush-but-street-to-see-29-listings/articleshow/134651498.cms","source":"Markets-Economic Times","published_at":"2026-10-03T04:11:07Z","symbols":[],"sentiment":0.7579,"sentiment_label":"positive","provider":"rss","via_symbol_feed":false},{"id":"c030eee3ffd6ff47","title":"​Bonus issues & stock split: 5 stocks rewarding shareholders next week","summary":"The list remains tentative as more companies may announce record dates for bonus issues and stock splits during the week.","url":"https://economictimes.indiatimes.com/markets/stocks/news/bonus-issues-stock-split-5-stocks-rewarding-shareholders-next-week/slideshow/134651748.cms","source":"Markets-Economic Times","published_at":"2026-10-03T04:02:49Z","symbols":[],"sentiment":0.7845,"sentiment_label":"positive","provider":"rss","via_symbol_feed":false}]
