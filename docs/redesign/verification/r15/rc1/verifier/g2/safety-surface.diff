-            requestPayload={
-                "symbol": proposal.symbol,
-                "qty": proposal.quantity,
-                "side": proposal.side,
-                "type": proposal.type,
-                "limit_price": proposal.limit_price,
-                "stop_price": proposal.stop_price,
-            },
-            responsePayload=_order_to_dict(order),
