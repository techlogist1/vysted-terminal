-            "exchange": self._exchange_id,
-            "symbol": proposal.symbol,
-            "type": proposal.type,
-            "side": proposal.side,
-            "amount": proposal.quantity,
-            "price": proposal.limit_price,
-            "stopPrice": proposal.stop_price,
-        }
