+      const portfolioId = portfolio?.id ?? "";
+      const label = target?.symbol || symbol || "position";
+      if (name === "portfolio_delete_position") {
+        return { name, portfolioId, label, target, problem };
+      }
+      const holding = holdingFields(input, target);
+      return {
+        name,
+        portfolioId,
+        label,
+        target,
