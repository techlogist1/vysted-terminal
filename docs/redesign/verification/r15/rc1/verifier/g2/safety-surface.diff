-
-def _angel_order_type(order_type: str) -> str:
-    mapping = {
-        "market": "MARKET",
-        "limit": "LIMIT",
-        "stop": "STOPLOSS_MARKET",
-        "stop-limit": "STOPLOSS_LIMIT",
-    }
-    return mapping.get(order_type, "MARKET")
